<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 360 Degree Orbital Outer Ring Arc (Electric Blue to Cyan) -->
    <path
        android:pathData="M54,22 C71.67,22 86,36.33 86,54 C86,71.67 71.67,86 54,86 C36.33,86 22,71.67 22,54 C22,46.5 24.6,39.6 28.9,34.1"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:color="#00D2FF" android:offset="0.0" />
                <item android:color="#2563EB" android:offset="0.6" />
                <item android:color="#38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbital Pulse Dot (Top Right) -->
    <path
        android:pathData="M78,30 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0"
        android:fillColor="#00D2FF" />

    <!-- Academic Graduation Diamond Top (Main Cap) -->
    <path
        android:pathData="M54,34 L76,46 L54,58 L32,46 Z"
        android:strokeWidth="1"
        android:strokeColor="#1E3A8A">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="34"
                android:endX="76"
                android:endY="58"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#2563EB" android:offset="0.7" />
                <item android:color="#1D4ED8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Academic Cap Inner Skull Base -->
    <path
        android:pathData="M40,51.5 L40,63 C40,68 46,71 54,71 C62,71 68,68 68,63 L68,51.5 C64,54 59,55.5 54,55.5 C49,55.5 44,54 40,51.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="51"
                android:endX="68"
                android:endY="71"
                android:type="linear">
                <item android:color="#2563EB" android:offset="0.0" />
                <item android:color="#1E40AF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cap Highlight Edge -->
    <path
        android:pathData="M54,34 L76,46 L54,58"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.8" />

    <!-- Graduation Tassel String & Bob -->
    <path
        android:pathData="M54,46 Q70,48 73,59 L73,66"
        android:strokeWidth="2"
        android:strokeColor="#00D2FF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M73,66 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0"
        android:fillColor="#00D2FF" />

    <!-- Center Core Point -->
    <path
        android:pathData="M54,46 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0"
        android:fillColor="#FFFFFF" />
</vector>